# Variables que consume api/contact.js
# En producción NO se usa este fichero: se configuran en
#   Vercel → el proyecto → Settings → Environment Variables
# Copia a `.env` solo si vas a probar en local con `vercel dev` (.env está en .gitignore).

# API key de Resend (resend.com → API Keys). OBLIGATORIA.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Dónde llega el aviso de cada mensaje nuevo.
MAIL_TO=lisayitingyang@gmail.com

# Remitente. Tiene que ser un dominio VERIFICADO en Resend.
# Mientras lisayangtang.com no esté verificado, deja esta línea comentada:
# el código cae en onboarding@resend.dev, que solo entrega a la dirección
# dueña de la cuenta de Resend (llega el aviso, no el acuse al visitante).
# MAIL_FROM=Yi-Ting Yang Tang <hola@lisayangtang.com>
