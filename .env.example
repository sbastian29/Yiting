# Variables que consume api/contact.js
# En produccion NO se usa este fichero: se configuran en
#   Vercel -> el proyecto -> Settings -> Environment Variables
# Copia a `.env` solo si vas a probar en local con `vercel dev` (.env esta en .gitignore).

# --- Cuenta de Gmail desde la que sale el correo -------------------------
# Tiene que ser la cuenta real: Gmail solo permite enviar desde la direccion
# con la que te autenticas.
GMAIL_USER=lisayitingyang@gmail.com

# Contrasena de aplicacion de 16 letras (NO la contrasena normal de la cuenta).
# Se genera en https://myaccount.google.com/apppasswords y requiere tener
# activada la verificacion en dos pasos. Google la muestra en 4 bloques
# separados por espacios: da igual, el codigo los limpia solo.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Enrutado ------------------------------------------------------------
# Donde llega el aviso de cada mensaje nuevo. Por defecto, GMAIL_USER.
# Ponlo a otro buzon si quieres desviar los avisos mientras pruebas.
MAIL_TO=lisayitingyang@gmail.com

# A donde contesta el visitante si responde al acuse de recibo.
REPLY_TO=lisayitingyang@gmail.com

# Nombre visible del remitente. La direccion no se puede cambiar: Gmail
# reescribe cualquier otra a la de la cuenta autenticada.
MAIL_FROM_NAME=Yi-Ting Yang Tang
